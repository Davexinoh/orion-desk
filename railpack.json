{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.12",
    "node": "20"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "npm ci --prefix web",
        "npm run build --prefix web"
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT --app-dir server"
  }
}
